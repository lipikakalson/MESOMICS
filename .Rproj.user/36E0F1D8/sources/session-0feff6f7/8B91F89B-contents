#' Step 2: Run MOFA for MESOMICS + test sample(s)
#'
#' Runs MOFA2 on the inputs produced by \code{add_sample_to_mofa()}, one model per sample,
#' and writes \code{MOFA-<sample>.hdf5} files.
#'
#' @name run_mofa
#' @param inputs_dir Directory with 'add_sample_to_mofa' output files: D_*_MOFA_<sample>.RData
#' @param outdir Directory to write HDF5 results (MOFA-<sample>.hdf5)
#' @param num_factors,convergence_mode,maxiter,use_basilisk MOFA options
#' @param skip_existing Skip if MOFA-<sample>.hdf5 already exists (default TRUE)
#' @return Invisibly, a named logical vector (sample -> TRUE on success/skip, FALSE on error)
#' @export
#'
#'
run_mofa <- function(
    inputs_dir       = "output/",   # <— default added
    outdir           = "output",
    num_factors      = 10,
    convergence_mode = "slow",
    maxiter          = 10000,
    use_basilisk     = TRUE,
    skip_existing    = TRUE
) {


  if (!dir.exists(inputs_dir)) stop("inputs_dir does not exist: ", inputs_dir)

  # --- updated: force this script to use the exact conda env as used in standalone script ---
  # if (!requireNamespace("reticulate", quietly = TRUE)) {
  #   stop("Package 'reticulate' is required when use_basilisk = FALSE.")
  # }
  # reticulate::use_python("/home/lipikal/miniconda3/envs/mofa_env/bin/python", required = TRUE)
  # -----------------------------------------------------------------------------------------



  views_map <- c(
    RNA     = "D_exprB_MOFA",
    MethPro = "D_met.proB_MOFA",
    MethBod = "D_met.bodB_MOFA",
    MethEnh = "D_met.enhB_MOFA",
    Total   = "D_cnv_MOFA",
    Minor   = "D_loh_MOFA",
    Alt     = "D_alt_MOFA"
  )

  rdata_files <- list.files(inputs_dir, pattern = "\\.RData$", full.names = TRUE)
  if (!length(rdata_files)) stop("No .RData files found in: ", inputs_dir)

  get_sample <- function(x) sub(".*_(.+)\\.RData$", "\\1", basename(x))
  samples <- unique(get_sample(rdata_files))
  samples <- samples[nzchar(samples)]

  results <- setNames(logical(length(samples)), samples)

  for (sample in samples) {
    outfile <- file.path(outdir, paste0("MOFA-", sample, ".hdf5"))
    if (skip_existing && file.exists(outfile)) {
      message("Skipping ", sample, " (exists: ", outfile, ")")
      results[[sample]] <- TRUE
      next
    }

    # --- key change: avoid regex, use endsWith() ---
    files_for_sample <- rdata_files[
      endsWith(basename(rdata_files), paste0("_", sample, ".RData"))
    ]
    if (!length(files_for_sample)) {
      warning("No input files found for sample: ", sample)
      results[[sample]] <- FALSE
      next
    }

    tenv <- new.env(parent = emptyenv())
    for (f in files_for_sample) load(f, envir = tenv)

    view_list <- list()
    missing <- character(0)
    for (view_nm in names(views_map)) {
      obj_nm <- views_map[[view_nm]]
      if (!exists(obj_nm, envir = tenv, inherits = FALSE)) {
        missing <- c(missing, view_nm); next
      }
      m <- get(obj_nm, envir = tenv)
      if (!is.matrix(m)) m <- as.matrix(m)
      storage.mode(m) <- "double"
      view_list[[view_nm]] <- m
    }

    if (!length(view_list)) {
      warning("Sample ", sample, ": no usable views (missing: ", paste(missing, collapse = ", "), ")")
      results[[sample]] <- FALSE
      next
    }
    if (length(missing)) {
      message("Sample ", sample, " missing views: ", paste(missing, collapse = ", "),
              " — proceeding with ", length(view_list), " view(s).")
    }

    common_cols <- Reduce(intersect, lapply(view_list, colnames))
    if (!length(common_cols)) {
      warning("Sample ", sample, ": no overlapping columns across views.")
      results[[sample]] <- FALSE
      next
    }
    view_list <- lapply(view_list, function(m) m[, common_cols, drop = FALSE])

    MOFAobject <- MOFA2::create_mofa(view_list)
    data_opts  <- MOFA2::get_default_data_options(MOFAobject)
    model_opts <- MOFA2::get_default_model_options(MOFAobject)
    model_opts$num_factors <- as.integer(num_factors)
    if ("Alt" %in% names(view_list)) model_opts$likelihoods["Alt"] <- "bernoulli"
    train_opts <- MOFA2::get_default_training_options(MOFAobject)
    train_opts$convergence_mode <- convergence_mode
    train_opts$maxiter <- as.integer(maxiter)

    MOFAobject <- MOFA2::prepare_mofa(
      object = MOFAobject,
      data_options = data_opts,
      model_options = model_opts,
      training_options = train_opts
    )

    MOFA2::run_mofa(
      MOFAobject,
      save_data    = TRUE,
      use_basilisk = use_basilisk,
      outfile      = outfile
    )

    message("✓ Saved: ", outfile)
    results[[sample]] <- TRUE
  }

  invisible(results)
}
