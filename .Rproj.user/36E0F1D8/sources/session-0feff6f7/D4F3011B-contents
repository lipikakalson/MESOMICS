#'  Step 3: Plot test sample on MESOMICS MOFA (per model) + all sample ternary plot
#'
#' For each \code{MOFA-*.hdf5} model, selects two MOFA latent factors by correlation to MESOMICS axes,
#' builds a 2D Pareto triangle (3 archetypes), and saves a PDF scatter with the test sample highlighted.
#' Additionally, collects the test sample's ternary coordinates across models and plots them at the end.
#'
#' @param models_dir Directory containing MOFA-*.hdf5 from 'run_mofa'.
#' @param MESOMICS.LFs Path to MESOMICS_latent_factors.csv.
#' @param out_plot_dir output plots.
#' @param group MOFA group name (default "group1").
#' @param n_cor_rows Use first N rows for correlation (default 120).  # (kept as in your docs; logic unchanged)
#' @param highlight_index test sample row (default 121).
#' @param python_bin Python environment
#' @param out_ternary_file File path for the final ternary plot.
#' @return Invisibly returns character vector of written per-model PDF paths (unchanged).
#' @export
plot_test_samples <- function(
    models_dir      = "output/",
    MESOMICS.LFs    = system.file("extdata", "MESOMICS_latent_factors.csv", package = "MESOMICS"),
    out_plot_dir    = file.path(models_dir, "plots"),
    group           = "group1",
    n_cor_rows      = 120,
    highlight_index = 121,
    python_bin,
    out_ternary_file = file.path(models_dir, "plots", "ternary_plot_all_samples.svg")
) {

  if (!dir.exists(models_dir)) stop("models_dir does not exist: ", models_dir)
  if (!file.exists(MESOMICS.LFs)) stop("MESOMICS.LFs not found: ", MESOMICS.LFs)
  if (!dir.exists(out_plot_dir)) dir.create(out_plot_dir, recursive = TRUE, showWarnings = FALSE)

  if (!requireNamespace("reticulate", quietly = TRUE)) stop("Package 'reticulate' is required.")
  reticulate::use_python(python_bin, required = TRUE)

  # ADDED: we use Ternary at the very end
  if (!requireNamespace("Ternary", quietly = TRUE)) stop("Package 'Ternary' is required.")

  model_files <- list.files(models_dir, pattern = "\\.hdf5$", full.names = TRUE)
  if (!length(model_files)) stop("No .hdf5 files in: ", models_dir)

  MESOMICS.LFs <- utils::read.csv(MESOMICS.LFs)

  written <- character(0)

  # ADDED: storage for highlighted sample ternary coords across models
  highlighted_ternary <- NULL

  for (i in seq_along(model_files)) {
    MOFAmodel <- MOFA2::load_model(model_files[i])

    # same logic: pull factors; you used @ slot, keep that style
    MOFA.LFs <- as.data.frame(MOFAmodel@expectations$Z[[group]])

    cor.tmp  <- cor(MOFA.LFs[1:120, ],
                    MESOMICS.LFs[, 4:5])

    LFs.tmp  <- apply(abs(cor.tmp), 2, which.max)
    LFs.tmp2 <- tibble::as_tibble(MOFA.LFs[, LFs.tmp])

    if (cor.tmp[LFs.tmp[1], 1] < 0) LFs.tmp2[, 1] <- -LFs.tmp2[, 1]
    if (cor.tmp[LFs.tmp[2], 2] < 0) LFs.tmp2[, 2] <- -LFs.tmp2[, 2]
    colnames(LFs.tmp2) <- c("Morphological.factor", "Immune.response.factor")

    # Pareto archetypes (k = 3)
    fit <- ParetoTI::k_fit_pch(
      t(LFs.tmp2),
      ks              = 3,
      check_installed = TRUE,
      bootstrap       = FALSE,
      volume_ratio    = "t_ratio"
    )

    arc <- as.data.frame(fit$XC) # 2 x 3; columns are archetypes
    colnames(arc) <- c("Arc1","Arc2","Arc3")

    # plotting
    p <- ggplot2::ggplot(LFs.tmp2, ggplot2::aes(x = Morphological.factor, y = Immune.response.factor)) +
      ggplot2::geom_point(cex = 2) +
      ggplot2::geom_segment(
        data = as.data.frame(t(arc)),
        ggplot2::aes(
          x = unlist(arc[1,]), xend = unlist(arc[1, c(2, 3, 1)]),
          y = unlist(arc[2,]), yend = unlist(arc[2, c(2, 3, 1)])
        ),
        col = "lightblue", cex = 2
      ) +
      ggplot2::geom_point(
        data = as.data.frame(t(arc)),
        col = scales::alpha(c("#B81330", "#58839D", "#79A960"), 0.7),
        cex = 5
      ) +
      ggplot2::geom_text(
        data = as.data.frame(t(arc)),
        label = 1:3, col = "black", cex = 4
      ) +
      gghighlight::gghighlight(seq_len(nrow(LFs.tmp2)) == highlight_index) +
      ggplot2::theme_bw()

    # save
    sample_id <- sub("\\.hdf5$", "", basename(model_files[i]))
    out_pdf   <- file.path(out_plot_dir, paste0(sample_id, ".pdf"))
    ggplot2::ggsave(out_pdf, plot = p, width = 8, height = 6)
    cat("Processed model:", basename(model_files[i]), "\n")

    written <- c(written, out_pdf)

    # collect highlighted sample's ternary coordinates for this model
    # fit$S is (k x n); transpose to (n x k) so rows are samples, cols are Arc1:Arc3
    S <- t(fit$S)
    colnames(S) <- c("Arc1","Arc2","Arc3")
    S <- as.data.frame(S)

    rn <- rownames(MOFA.LFs)
    if (!is.null(rn) && nrow(S) == length(rn)) rownames(S) <- rn

    if (highlight_index <= nrow(S)) {
      hl <- S[highlight_index, , drop = FALSE]
      row.names(hl) <- sample_id
      highlighted_ternary <- rbind(highlighted_ternary, hl)
    } else {
      warning("highlight_index > number of rows in model: ", basename(model_files[i]))
    }
  }

  # final ternary plot of all highlighted samples
  if (!is.null(highlighted_ternary) && nrow(highlighted_ternary)) {

    grDevices::svg(out_ternary_file, height = 6, width = 6)

    Ternary::TernaryPlot(point = "up", alab = "Invasion and tissue remodelling",
                         blab = "Good-prognosis", clab = "Cold tumours",
                         lab.cex = 0.8, grid.minor.lines = 0,
                         grid.lines = 0,
                         lab.offset = 0.18,
                         grid.lty = 'blank', col = grDevices::rgb(1, 1, 1), grid.col = 'white',
                         axis.col = grDevices::rgb(0.6, 0.6, 0.6), ticks.col = grDevices::rgb(0.6, 0.6, 0.6),
                         axis.rotate = FALSE,
                         padding = 0.12)
    Ternary::TernaryLines(list(c(0, 255, 0), rep(50,3)), col = 'grey')
    Ternary::TernaryLines(list(c(0, 0, 255), rep(50,3)), col = 'grey')
    Ternary::TernaryLines(list(c(255, 0, 0), rep(50,3)), col = 'grey')

    # your samples → same ordering (c(2,3,1))
    Ternary::AddToTernary(graphics::points,
                          highlighted_ternary[, c("Arc2","Arc3","Arc1")],
                          pch = 21, cex = 2,
                          bg = scales::alpha("#58839D", 0.7),
                          col = "white")

    # your reference triangle markers + numbers
    data_points <- list(
      "1" = c(0, 0, 255),
      "2" = c(255, 0, 0),
      "3" = c(0, 255, 0)
    )
    xy <- Ternary::CoordinatesToXY(data_points)
    graphics::points(
      xy[1, ] + c(-sqrt(0.1^2/2), 0, sqrt(0.1^2/2)),
      xy[2, ] + c(-sqrt(0.1^2/2), 0.1, -sqrt(0.1^2/2)),
      pch = 19, cex = 2.8,
      col = scales::alpha(c("#B81330", "#58839D", "#79A960"), 0.7)
    )
    graphics::text(
      xy[1, ] + c(-sqrt(0.1^2/2), 0, sqrt(0.1^2/2)),
      xy[2, ] + c(-sqrt(0.1^2/2), 0.1, -sqrt(0.1^2/2)),
      names(data_points), cex = 0.8, font = 2
    )

    # your arc names
    arc_name <- c("Cell division", "Tumor-immune interaction", "Acinar")
    graphics::text(
      xy[1, ] + c(-sqrt(0.04^2), 0, sqrt(0.08^2)),
      xy[2, ] + c(-sqrt(0.2^2), 0.2, -sqrt(0.2^2)),
      arc_name, cex = 0.6, font = 1
    )

    grDevices::dev.off()
    cat("Saved ternary plot to:", out_ternary_file, "\n")
  }

  invisible(written)
}
